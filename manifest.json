{
  "manifest_version": 3,
  "name": "Website Scraping & QC Helper",
  "version": "2.2.0",
  "description": "Auto-grab business details based on URL with strict QC rules, forbidden industry checks, and 1-click portal auto-fill.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extractor.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": false,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Website QC Helper",
    "default_popup": "popup.html"
  }
}